# Optional settings for pay.sh. Copy to .env, edit, then: set -a; . ./.env; set +a
# No keys here: accounts are Stellar CLI identities (stellar keys ls).

# Network and RPC endpoint.
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org

# Prefix for the three CLI identities the script creates: <prefix>-payer, -agent, -issuer.
IDENTITY_PREFIX=puls3-poc

# Hire id carried as the muxed id of the agent's address (unsigned 64-bit integer).
HIRE_ID=1

# Price in stroops (7 decimals): 5000000 = 0.50.
AMOUNT=5000000

# Leave empty to issue a throwaway test asset (PUSDC).
# To pay in Circle's testnet USDC instead, fund the payer at https://faucet.circle.com and set:
# ASSET=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ASSET=
