{
  "name": "@puls3/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for the puls3 API: the agent catalog, hires and the Agent Studio.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zer0-Knowledge-Hack/puls3.git",
    "directory": "puls3_sdk_ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/*.test.js\"",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "live": "tsc -p tsconfig.test.json && node build-test/examples/live-testnet.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@stellar/stellar-base": "15.0.0"
  }
}
