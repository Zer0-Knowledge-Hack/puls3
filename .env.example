# Settings for scripts/deploy-testnet.sh and scripts/seed-demo-agents.sh.
# Copy to .env, edit, then: set -a; . ./.env; set +a
# No keys here: STELLAR_ACCOUNT is the name of a Stellar CLI identity (stellar keys ls).

# Stellar CLI identity that deploys the contract and owns the seeded demo agents.
# Create and fund it once: stellar keys generate <name> --fund --network testnet
STELLAR_ACCOUNT=

# Network to deploy to.
STELLAR_NETWORK=testnet

# Optional: collection name and symbol passed to the Identity Registry constructor.
REGISTRY_NAME=Puls3 Agent
REGISTRY_SYMBOL=P3AGENT
